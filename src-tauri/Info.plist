<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>NSMicrophoneUsageDescription</key>
  <string>OpenSpeech 需要访问麦克风以进行语音输入。</string>

  <!-- 输入监控：rdev::listen 监听全局快捷键（Fn / Ctrl+Win 等）。
       macOS 不强制此 key，但部分系统设置 UI 会读它来展示授权说明文案；
       提供之，体验更顺。 -->
  <key>NSInputMonitoringUsageDescription</key>
  <string>OpenSpeech 需要监听全局快捷键以触发听写录音。</string>

  <!-- 辅助功能：enigo 模拟键盘把转写文字粘贴回当前焦点输入框时需要。
       enigo 通过 CGEventPost 直接合成键盘事件，**不**走 AppleEvents/AppleScript，
       所以无需 NSAppleEventsUsageDescription 声明。 -->
  <key>NSAccessibilityUsageDescription</key>
  <string>OpenSpeech 需要辅助功能权限以将识别后的文字写入当前焦点的输入框。</string>

  <!-- 蓝牙中央角色：扫描 ESP32 无线麦克风的 BLE 广播以发现可配对设备。
       macOS 12+ 强制要求；缺失会让 CoreBluetooth 在首次 start_scan 时直接拒绝。 -->
  <!-- 系统音频录制（macOS 14.4+）：会议录制用 Core Audio process tap 录本机正在播放的
       声音（会议软件里对方的发言）。首次开会时系统按此文案弹授权；缺失时 tap 只给静音。 -->
  <key>NSAudioCaptureUsageDescription</key>
  <string>OpenSpeech 需要录制系统声音，以便会议录制时转写会议软件里对方的发言。</string>

  <key>NSBluetoothAlwaysUsageDescription</key>
  <string>OpenSpeech 需要蓝牙权限以扫描并配对 ESP32 无线麦克风设备。</string>
</dict>
</plist>
